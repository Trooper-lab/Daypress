[Unit]
Description=Daypress — Self-Hosted Rust CMS with 1-Click WP Migration & Built-in MCP Server
Documentation=https://daypress.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=daypress
Group=daypress
WorkingDirectory=/var/lib/daypress
StateDirectory=daypress
Environment="PORT=8090"
Environment="HOST=0.0.0.0"
Environment="DATABASE_PATH=/var/lib/daypress/daypress.sqlite"
Environment="DAYPRESS_NO_BROWSER=1"
EnvironmentFile=-/etc/default/daypress
ExecStart=/usr/bin/daypress
Restart=on-failure
RestartSec=5s

# Allow binding privileged ports (:80 / :443 for built-in ACME Let's Encrypt TLS) without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/daypress

[Install]
WantedBy=multi-user.target

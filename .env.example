# Daypress Server Configuration
PORT=8080
DATABASE_PATH=data/daypress.sqlite
RUST_LOG=info,daypress_server=debug,tower_http=info

# Daypress AI Transpiler Configuration (Optional, for transpiling PHP modules to Rust)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# First-run admin password (optional; otherwise a random one is printed once on first start)
# DAYPRESS_ADMIN_PASSWORD=choose-a-long-password

# Outgoing email for form notifications (optional; nothing is sent without a host)
# DAYPRESS_SMTP_HOST=smtp.example.com
# DAYPRESS_SMTP_PORT=587
# DAYPRESS_SMTP_SECURITY=starttls
# DAYPRESS_SMTP_USER=postmaster@example.com
# DAYPRESS_SMTP_PASSWORD=
# DAYPRESS_SMTP_FROM=noreply@example.com
# DAYPRESS_SMTP_FROM_NAME=My Site

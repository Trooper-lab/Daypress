# Neopress Server Configuration
PORT=8080
DATABASE_PATH=data/neopress.sqlite
RUST_LOG=info,neopress_server=debug,tower_http=info

# Neopress AI Transpiler Configuration (Optional, for transpiling PHP modules to Rust)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# First-run admin password (optional; otherwise a random one is printed once on first start)
# NEOPRESS_ADMIN_PASSWORD=choose-a-long-password

# Outgoing email for form notifications (optional; nothing is sent without a host)
# NEOPRESS_SMTP_HOST=smtp.example.com
# NEOPRESS_SMTP_PORT=587
# NEOPRESS_SMTP_SECURITY=starttls
# NEOPRESS_SMTP_USER=postmaster@example.com
# NEOPRESS_SMTP_PASSWORD=
# NEOPRESS_SMTP_FROM=noreply@example.com
# NEOPRESS_SMTP_FROM_NAME=My Site
